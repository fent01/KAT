        "def ModelPick(board_tensor_input, legal_moves_list, return_logits=False):\n",
        "    uci_move_strings = [move.uci() for move in legal_moves_list]\n",
        "    ind = ToIndex(uci_move_strings)\n",
        "\n",
        "    mask = T.zeros(4096, dtype=T.bool, device=board_tensor_input.device)\n",
        "    mask[ind] = True\n",
        "\n",
        "    logits = model(board_tensor_input)\n",
        "    logits = logits.masked_fill(\n",
        "      ~mask.unsqueeze(0),\n",
        "      float(\"-inf\")\n",
        "    )\n",
        "\n",
        "    if return_logits:\n",
        "        return logits\n",
        "    else:\n",
        "        prediction_index = T.argmax(logits, dim=1)\n",
        "        final = index_to_move(prediction_index)\n",
        "        return final\n",
        "\n",
        "def ChessLoop(board):\n",
        "  board_tensors = board_to_tensor(board)\n",
        "  board_tensors = board_tensors.unsqueeze(0)\n",
        "\n",
        "  legal_moves = list(board.legal_moves)\n",
        "\n",
        "\n",
        "  move_uci = ModelPick(board_tensors, legal_moves)\n",
        "  board.push(chess.Move.from_uci(move_uci))"
      ]

        "class Network(nn.Module):\n",
        "  def __init__(self, input_size=768, output_size=4096): # nigger stupid nigger\n",
        "    super().__init__()\n",
        "    self.flatten = nn.Flatten()\n",
        "    self.linear1 = nn.Linear(input_size,64 )\n",
        "    self.relu1 = nn.ReLU()\n",
        "    self.linear2 = nn.Linear(64, 500)\n",
        "    self.relu2 = nn.ReLU()\n",
        "    self.linear3 = nn.Linear(500, 500)\n",
        "    self.relu3 = nn.ReLU()\n",
        "    self.linear4 = nn.Linear(500, 256)\n",
        "    self.relu4 = nn.ReLU()\n",
        "    self.linear5 = nn.Linear(256, output_size)\n",
        "\n",
        "  def forward(self, x):\n",
        "    x = self.flatten(x)\n",
        "    x = self.linear1(x)\n",
        "    x = self.relu1(x)\n",
        "    x = self.linear2(x)\n",
        "    x = self.relu2(x)\n",
        "    x = self.linear3(x)\n",
        "    x = self.relu3(x)\n",
        "    x = self.linear4(x)\n",
        "    x = self.relu4(x)\n",
        "    x = self.linear5(x)\n",
        "    return x"
      ]
    },
